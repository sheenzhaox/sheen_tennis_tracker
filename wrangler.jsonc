{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sheen-tennis-tracker",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "vars": { "ENVIRONMENT": "production" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sheen-tennis-tracker",
      "database_id": "6e70b0d1-1e78-440f-b354-2d2316e2fcc4",
      "migrations_dir": "migrations"
    }
  ],
  "observability": { "enabled": true },
  // Previews (non-main branches) must never touch production data.
  "previews": {
    "vars": { "ENVIRONMENT": "preview" },
    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "sheen-tennis-tracker-preview",
        "database_id": "a8b2a5f4-96db-4bee-a04b-839ac21af1be"
      }
    ]
  }
}
